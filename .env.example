# polysearch environment variables
#
# Copy this file to .env and fill in the keys for the tier you want to run.
# Missing credentials don't break the pipeline — the corresponding layer is
# replaced with a null provider and the orchestrator runs the layers it can.
#
# ── Tier 0: Perplexity-only (the minimum) ─────────────────────────────────
# Sign up: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# ── Tier 1: web grounding + synthesis ─────────────────────────────────────
# Firecrawl — web search + scrape with paywall handling
# Sign up: https://www.firecrawl.dev
FIRECRAWL_API_KEY=

# At least one of OpenAI or Anthropic is needed for cross-layer synthesis.
# If both are set, OpenAI is preferred (cheaper). Override with --synthesizer.

# OpenAI — gpt-5-mini default for synthesis, text-embedding-3-small for queries
# Sign up: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic — Claude Sonnet/Opus alternative for synthesis
# Sign up: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── Tier 2: vector context (optional, advanced) ───────────────────────────
# Qdrant Cloud — used to blend personal/organizational corpus into research
# Sign up: https://cloud.qdrant.io
QDRANT_URL=
QDRANT_API_KEY=

# Collection name to query (must already exist in your Qdrant instance)
# QDRANT_COLLECTION=personal_context

# ── Tier 3: community signal (optional) ───────────────────────────────────
# Install last30days separately: https://github.com/mvanhorn/last30days-skill
# Polysearch will detect and use it if installed; no env var needed.

# ── Optional configuration ────────────────────────────────────────────────
# Override default output directory (defaults to ./reports/)
# POLYSEARCH_OUTPUT_DIR=

# Override default domain_tiers.yaml path
# POLYSEARCH_DOMAIN_TIERS_PATH=
