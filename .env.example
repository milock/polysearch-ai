# polysearch environment variables
#
# Copy this file to .env and fill in the keys for the tier you want to run.
# Missing credentials don't break the pipeline — the corresponding layer is
# replaced with a null provider and the orchestrator runs the layers it can.
# Start at Tier 0 and add keys as you need more coverage.

# ── Tier 0: Perplexity-only (the minimum to run) ──────────────────────────
# The one required key. With just this, polysearch runs Perplexity search +
# synthesis and returns a cited report.
# Sign up: https://www.perplexity.ai/settings/api
# PERPLEXITY_API_KEY=

# ── Tier 1: web grounding + cross-source synthesis ────────────────────────
# Adds live web search/scrape (with paywall handling) and a dedicated
# synthesizer model. Recommended for most users.

# Firecrawl — web search + scrape grounding
# Sign up: https://www.firecrawl.dev
# FIRECRAWL_API_KEY=

# At least one of OpenAI or Anthropic is needed for cross-source synthesis.
# If both are set, OpenAI is preferred (cheaper). Override with --synthesizer.

# OpenAI — synthesis + query embeddings
# Sign up: https://platform.openai.com/api-keys
# OPENAI_API_KEY=

# Anthropic — Claude alternative for synthesis
# Sign up: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=

# Brave Search — optional supplementary web search provider
# Sign up: https://brave.com/search/api
# BRAVE_API_KEY=

# ── Tier 2: extra source connectors (all optional) ────────────────────────
# Each key lights up an additional source. Set only the ones you want; any
# left blank are simply skipped.

# ScrapeCreators — social / creator content lookups
# Sign up: https://scrapecreators.com
# SCRAPECREATORS_API_KEY=

# YouTube Data API — video + transcript search
# Enable: https://console.cloud.google.com/apis/library/youtube.googleapis.com
# YOUTUBE_API_KEY=

# GitHub — repo / code / issue search at a higher rate limit
# Create a token: https://github.com/settings/tokens
# GITHUB_TOKEN=

# Reddit — community discussion search (OAuth app credentials)
# Create an app: https://www.reddit.com/prefs/apps
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=

# X / Twitter — comma-separated handles to pull recent posts from.
# Example: POLYSEARCH_X_HANDLES=handle_one,handle_two
# POLYSEARCH_X_HANDLES=

# ── Optional configuration ────────────────────────────────────────────────
# Enable deeper multi-step research (slower, more thorough). Set to 1 or true.
# POLYSEARCH_DEEP_RESEARCH=

# Override the default output directory (defaults to ./reports/).
# POLYSEARCH_OUTPUT_DIR=
